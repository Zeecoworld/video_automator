# Everything the worker needs. Copy to .env.worker (never commit it).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Clips are uploaded here until they are posted (Supabase Storage is used if this is empty).
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- AI: no Gemini needed. Faster-Whisper transcribes on your machine. ---
WHISPER_MODEL=small          # tiny | base | small | medium  (bigger = more accurate, slower)
# Pick the moments with a text model (any OpenAI-compatible API). Leave these empty to use the free rule-based picker.
# Ollama on the same PC:       LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_MODEL=llama3.1:8b
# Hugging Face (needs a token): LLM_BASE_URL=https://router.huggingface.co/v1   LLM_API_KEY=hf_...   LLM_MODEL=<a chat model you have access to>
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Optional: how often to look for new links (seconds), and a proxy if YouTube blocks your network
# POLL_SECONDS=60
# YTDLP_PROXY=http://user:pass@host:port

# --- Cloud hosting (Render, Railway, Fly.io, any VPS) ---
# There is no file to mount, so pass your YouTube/Instagram cookies as a variable (base64 of cookies.txt is safest):
#   Linux/Mac:   base64 -w0 cookies.txt
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
# YTDLP_COOKIES_B64=

# --- AI providers and storage (same as .env.example; set the ones you use) ---
# GROQ_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=
# HF_MODEL=
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
