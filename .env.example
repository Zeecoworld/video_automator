# ---- Netlify site env vars (Site configuration -> Environment variables). Never commit real values.
SITE_URL=https://your-site.netlify.app
CRON_SECRET=                      # long random string; guards the background functions and /api/*

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME   # optional; Supabase Storage is the fallback

# OAuth client of type "Web application". Redirect URI to register: SITE_URL/api/auth/youtube/callback
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=                # optional fallback; normally you press "Connect YouTube" on the dashboard

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# TIKTOK_MODE=direct               # or inbox
# TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
# YOUTUBE_PER_DAY=5
# TIKTOK_PER_DAY=10
# POSTING_TIMEZONE=Africa/Lagos
# RENDER_WIDTH=720
# RENDER_HEIGHT=1280

# ---- Worker on Modal (recommended): URL printed by `modal deploy modal/app.py`
MODAL_WORKER_URL=https://your-workspace--clip-engine-start.modal.run
# (Modal secret `clip-engine` holds SUPABASE_*, GEMINI_API_KEY, CLOUDINARY_URL, CRON_SECRET, YTDLP_COOKIES; optional YTDLP_PROXY)

# ---- Alternative: Cobalt (self-hosted download API, no GitHub Actions needed)
# COBALT_API_URL=https://your-cobalt.up.railway.app/
# COBALT_API_KEY=                # only if your instance requires API keys (recommended)
# COBALT_QUALITY=720             # lower (480) for long videos; Netlify functions have limited disk
# MAX_DOWNLOAD_MB=300

# ---- Optional alternative: yt-dlp worker on GitHub Actions / your own machine
# WORKER_MODE=github             # makes the page start the GitHub worker instead of the Netlify function
# GH_DISPATCH_TOKEN=             # fine-grained PAT, this repo only, "Actions: Read and write"
# GH_REPO=your-user/your-repo
# GH_REF=main
# YTDLP_COOKIES=                 # GitHub Actions secret: Netscape cookies.txt for YouTube + Instagram

# ---- Sign in to the dashboard with your email (Supabase Auth). Optional: the access key above keeps working.
# SUPABASE_ANON_KEY=               # Supabase -> Project Settings -> API -> anon public key
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# ---- AI providers (all optional; they are tried in order, then a rule-based picker)
# GROQ_API_KEY=                    # Whisper transcription (whisper-large-v3-turbo) + a text model
# GROQ_MODEL=llama-3.3-70b-versatile   # check Groq's current model list
# GEMINI_API_KEY=                  # text model, and listens to the audio if no transcript can be made
# HF_TOKEN=                        # Hugging Face: transcription (best effort) and, with HF_MODEL, a text model
# HF_MODEL=                        # a chat model you have access to, e.g. org/model-name
# TRANSCRIBERS=groq,huggingface,local
# TEXT_MODELS=groq,gemini,huggingface,custom

# ---- Clip storage: Cloudflare R2 and/or Cloudinary (R2 is tried first); Supabase Storage is the last resort
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# STORAGE_PROVIDER=r2              # or cloudinary / supabase to prefer another
