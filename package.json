{
  "name": "clip-engine-netlify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Long video -> short clips -> YouTube/TikTok, on Netlify (TypeScript)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx worker/run.ts",
    "worker:loop": "tsx worker/loop.ts",
    "doctor": "tsx worker/doctor.ts",
    "maintenance": "tsx worker/maintenance.ts",
    "fallback:check": "tsx worker/fallback-check.ts",
    "auth:youtube": "tsx scripts/youtube-auth.ts",
    "auth:tiktok": "tsx scripts/tiktok-auth.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "aws4fetch": "^1.0.20",
    "ffmpeg-static": "^5.2.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.0",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
